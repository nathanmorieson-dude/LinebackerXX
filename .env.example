# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Australian number in E.164 format, e.g. +61291234567
TWILIO_PHONE_NUMBER=+61xxxxxxxxx

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ── CosyVoice2 (local inference server) ───────────────────────────────────────
# Base URL of your running CosyVoice2 HTTP server
COSYVOICE2_BASE_URL=http://localhost:9880
# Speaker/voice ID supported by your CosyVoice2 server
COSYVOICE2_SPEAKER_ID=default
# HTTP path for TTS inference (adjust to match your server)
COSYVOICE2_ENDPOINT=/tts
# Speech speed multiplier (1.0 = normal)
COSYVOICE2_SPEED=1.0

# ── Whisper (local faster-whisper) ────────────────────────────────────────────
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v3
WHISPER_MODEL=base.en
# cpu or cuda
WHISPER_DEVICE=cpu
# int8, float16, float32 (int8 is fastest on CPU)
WHISPER_COMPUTE_TYPE=int8

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8765
# Set to your ngrok auth token for automatic tunnel on startup.
# Leave blank to skip (you can run ngrok manually and use configure_twilio.py).
NGROK_AUTHTOKEN=
